# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# rescheck config file (holds NHN Cloud tenantId/username/password in plaintext)
config.yaml

# instance_scheduler terraform state/working files (local backend + real infra values)
instance_scheduler/terraform/.terraform/
instance_scheduler/terraform/terraform.tfstate
instance_scheduler/terraform/terraform.tfstate.backup
instance_scheduler/terraform/*.tfvars
!instance_scheduler/terraform/terraform.tfvars.example

# Editor/IDE
# .idea/
# .vscode/

# Claude Code personal/local overrides (per-machine, not shared with team)
.claude/settings.local.json
CLAUDE.local.md
